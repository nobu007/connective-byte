# フロントエンド環境変数のテンプレート
# コピーして .env.local として使用: cp .env.example .env.local

# --- 必須 ---
# サイトのURL（本番環境で必須）
NEXT_PUBLIC_SITE_URL=https://connectivebyte.com
# お問い合わせ先メールアドレス
NEXT_PUBLIC_CONTACT_EMAIL=info@connectivebyte.com

# --- ニュースレター（Resend）---
# Resend APIキー（未設定の場合、ニュースレターAPIは設定エラーを返す）
# 本番ではNetlify UIの環境変数に設定（NETLIFY_DEPLOY.md参照）
RESEND_API_KEY=
# Resendのオーディエンス（購読者リスト）ID
RESEND_AUDIENCE_ID=

# --- Analytics（Plausible）---
# Plausibleの計測ドメイン
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# PlausibleのAPIホスト（デフォルト: https://plausible.io）
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io
# ローカル環境でのトラッキング有効化（開発時のみ）
NEXT_PUBLIC_PLAUSIBLE_TRACK_LOCALHOST=false
