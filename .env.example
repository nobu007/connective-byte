# ConnectiveByte — ローカル開発用環境変数テンプレート（全ワークスペース共通）
#
# 使い方:
#   cp .env.example .env   （リポジトリルートに置く。.env は git 管理外）
#
# このルート .env が唯一の設定場所。両ワークスペースの dev スクリプトが
# dotenv-cli でここを読む:
#   - apps/frontend  … next dev（NEXT_PUBLIC_* のビルド時埋め込み・API route）
#   - apps/backend   … ts-node（JWT_SECRET など）
# ファイルが無くても起動する（警告のみ）。本番はこのファイルを使わない:
#   - フロント/Function … Cloudflare Pages の環境変数（DEPLOYMENT_GUIDE.md）
#   - バックエンド      … デプロイ時の環境変数

# --- フロントエンド（apps/frontend） --------------------------------------
# --- 必須 ---
# サイトのURL（本番環境で必須）
NEXT_PUBLIC_SITE_URL=https://connectivebyte.com
# お問い合わせ先メールアドレス
NEXT_PUBLIC_CONTACT_EMAIL=info@connectivebyte.com

# --- ニュースレター / お問い合わせフォーム（Resend） ---
# Resend APIキー（未設定の場合: contact は開発モード送信、newsletter はエラー）
RESEND_API_KEY=
# Resendのオーディエンス（購読者リスト）ID
RESEND_AUDIENCE_ID=

# --- Analytics（Plausible） すべて任意 ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_TRACK_LOCALHOST=false

# --- バックエンド（apps/backend） -----------------------------------------
# JWT認証（未設定だと安全でないデフォルト値で動く。本番では必須・32文字以上）
JWT_SECRET=
# 認証モジュール用データベースパス（JSONファイルバックド、開発用）
AUTH_DB_PATH=data/auth/users.json
# 任意:
# アクセストークン寿命（短期が原則。リフレッシュは httpOnly Cookie cb_rt で30日）
# JWT_EXPIRES_IN=15m
# PORT=3001
# LOG_FORMAT=json
# LOG_LEVEL=debug
# API_KEYS=key1,key2

# --- Lab モジュール（apps/backend/src/modules/lab） lab API を使う場合必須 --
LAB_DATABASE_URL=
LAB_ENCRYPTION_KEY=
# LAB_SHARED_OPENAI_KEY=
# LAB_REDIS_URL=

# --- Cloudflare Pages（npm run deploy:cf）--------------------------------
# Cloudflare → My Profile → API Tokens → Create Token（テンプレート Edit Cloudflare Pages）
CLOUDFLARE_API_TOKEN=

# --- auth API（Cloudflare Workers + Neon Postgres: npm run deploy:api） ---
# Neon Postgres 接続文字列（設定すると backend が Postgres+Resend モードになる。
# 未設定はローカル開発用の JSON ファイル保存モード）
DATABASE_URL=
# 検証/リセットメールのリンク先サイトURL（Workers側では wrangler.toml の vars で設定）
# SITE_URL=https://connectivebyte.com
# フロントから auth API を呼ぶ際のベースURL（メールリンク着地ページが使用）
# NEXT_PUBLIC_API_URL=https://api.connectivebyte.com
# --- Google ログイン（OAuth）ローカル開発用 ---
# Google Cloud Console の OAuth client ID / Secret
# （本番は wrangler secret put で設定。redirect URI に
#   http://localhost:3001/api/auth/google/callback を登録する）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# コールバックURL のベース（既定 https://api.connectivebyte.com。localhost では必須）
# OAUTH_REDIRECT_BASE=http://localhost:3001
