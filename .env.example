# ConnectiveByte Environment Variables
# Copy this file to .env and set your actual values
#
# Frontend/Netlify variables (NEXT_PUBLIC_*, RESEND_*) are documented in
# apps/frontend/.env.example — in production set them in the Netlify UI.

# --- Backend (apps/backend) ---
# Server port (default: 3001)
# PORT=3001

# JWT authentication (required in production; auth falls back to an
# insecure default secret when unset)
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=1d

# Comma-separated API keys accepted by the API key middleware (optional)
# API_KEYS=key1,key2

# Logging (optional; defaults: pretty format, info level)
# LOG_FORMAT=json
# LOG_LEVEL=debug

# --- Lab module (apps/backend/src/modules/lab) ---
# Required when using the lab endpoints
LAB_DATABASE_URL=postgresql://user:password@localhost:5432/connectivebyte
# 32-byte key used for API key encryption
LAB_ENCRYPTION_KEY=
# Optional lab integrations
# LAB_SHARED_OPENAI_KEY=
# LAB_REDIS_URL=redis://localhost:6379
